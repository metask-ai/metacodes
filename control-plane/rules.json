{
  "schema_version": 1,
  "rules": [
    {
      "id": "declaration.agentdef-task-required.l2",
      "title": "AgentDef runtime declarations and Task required inputs have L2 evidence",
      "target": {
        "metric": "declared_minus_covered",
        "setpoint": 0,
        "goal": "Every governed declaration has an exact, runnable L2 evidence binding."
      },
      "sensor": {
        "adapter": "declaration_l2",
        "schema_version": 1,
        "evidence_registry": "control-plane/declaration-l2-evidence.json"
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.ClosedLoop.signal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "missing_evidence_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Add or repair a real L2 test and its evidence binding; do not silence the declaration.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "zig_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 300,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control",
            "-v"
          ],
          [
            "zig",
            "build",
            "test:agentdef-fields",
            "-Dtinykg=false",
            "-j2",
            "--summary",
            "all"
          ],
          [
            "zig",
            "build",
            "test:new",
            "-Dtinykg=false",
            "-Dtfilter=L2 schema: Task",
            "-j2",
            "--summary",
            "all"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    },
    {
      "id": "memory.evidence-freshness-governance.l2",
      "title": "TinyKG candidates expose identity, evidence, supersession, and current-state checks",
      "target": {
        "metric": "governance_obligations_minus_observed",
        "setpoint": 0,
        "goal": "Every automatic or explicit memory path remains candidate-only until executable evidence, supersession, contradiction, and freshness checks are visible."
      },
      "sensor": {
        "adapter": "memory_evidence_governance",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.ClosedLoop.signal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "missing_evidence_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore runtime node identity and structured governance signals plus their exact L2 assertions; prompt prose or manifest claims alone are insufficient.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "zig_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 300,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.MemoryGovernanceSensorTests",
            "-v"
          ],
          [
            "zig",
            "build",
            "test:kg-governance",
            "-Dtfilter=L2 KG governance:",
            "-j2",
            "--summary",
            "all"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    },
    {
      "id": "ontology.execution-grounded-projection.l2",
      "title": "Successful host execution feeds tentative TinyKG ontology projection",
      "target": {
        "metric": "execution_projection_obligations_minus_observed",
        "setpoint": 0,
        "goal": "The successful-execution sensor, task-close projection actuator, and focused real-TinyKG feedback remain connected without trusting model self-report."
      },
      "sensor": {
        "adapter": "execution_ontology_feedback",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.ClosedLoop.executionProjectionSignal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "execution_projection_admitted_implies_three_obligations",
          "execution_projection_missing_obligation_blocks",
          "execution_projection_wrong_cardinality_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore the production success sensor, terminal projection/retention report, and focused real-TinyKG L2. Comments, prompt claims, skipped tests, and model-supplied acts_on/uses/produces are not execution evidence.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "zig_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 300,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.ExecutionOntologySensorTests",
            "scripts.tests.test_rule_control.FeedbackExecutionTests",
            "-v"
          ],
          [
            "zig",
            "build",
            "test:kg-ontology-feedback",
            "-Dtfilter=L2 KG ontology feedback:",
            "-j2",
            "--summary",
            "all"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    },
    {
      "id": "build.test-throughput-integrity.l2",
      "title": "Build and test throughput improves without losing coverage or failure semantics",
      "target": {
        "metric": "build_test_integrity_obligations_minus_observed",
        "setpoint": 0,
        "goal": "Per-test diagnostics, deterministic sharding, fail-closed aggregation, exact aggregate inventory, and explicit fast/full build paths remain connected while wall, CPU, RSS, and critical-path measurements are collected as host observations."
      },
      "sensor": {
        "adapter": "build_test_throughput",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.ClosedLoop.buildTestSignal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "build_test_admitted_implies_five_obligations",
          "build_test_missing_obligation_blocks",
          "build_test_wrong_cardinality_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore exact test inventory, deterministic partition fingerprints, checked aggregate accounting, leak/failure propagation, per-test timing diagnostics, and the separate dev/full build paths. A lower wall time without these obligations is not an admissible optimization.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "zig_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 600,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.BuildTestThroughputSensorTests",
            "scripts.tests.test_rule_control.FeedbackExecutionTests",
            "-v"
          ],
          [
            "zig",
            "build",
            "test:lib-shard-harness",
            "-j4"
          ],
          [
            "zig",
            "build",
            "test:lib",
            "-Dlib-test-shards=4",
            "-j4"
          ],
          [
            "zig",
            "build",
            "test:integration-monolithic",
            "-j4"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    }
  ]
}
