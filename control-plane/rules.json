      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore the production success sensor, terminal projection/retention report, and focused real-TinyKG L2. Comments, prompt claims, skipped tests, and model-supplied acts_on/uses/produces are not execution evidence.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
