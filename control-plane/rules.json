    {
      "id": "build.test-throughput-integrity.l2",
      "title": "Build and test throughput improves without losing coverage, failure semantics, or reproducible identities",
      "target": {
        "metric": "build_test_integrity_obligations_minus_observed",
        "setpoint": 0,
        "goal": "Per-test diagnostics, deterministic sharding, fail-closed aggregation, exact aggregate inventory, explicit fast/full build paths, a location-independent TinyKG binary, and a time-independent formal artifact identity with a separately verified build receipt remain connected while wall, CPU, RSS, and critical-path measurements are collected as host observations."
      },
      "sensor": {
        "adapter": "build_test_throughput",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.ClosedLoop.buildTestSignal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "build_test_admitted_implies_seven_obligations",
          "build_test_missing_obligation_blocks",
          "build_test_wrong_cardinality_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore exact test inventory, deterministic partition fingerprints, checked aggregate accounting, leak/failure propagation, per-test timing diagnostics, separate dev/full build paths, the isolated TinyKG double build, and the complete formal double-build identity/receipt check. A lower wall time, a location-dependent binary, or an identity polluted by build time is not admissible.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "zig_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 600,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.BuildTestThroughputSensorTests",
            "scripts.tests.test_rule_control.FeedbackExecutionTests",
            "-v"
          ],
          [
            "zig",
            "build",
            "test:lib-shard-harness",
            "-j4"
          ],
          [
            "zig",
            "build",
            "test:lib",
            "-Dlib-test-shards=4",
            "-j4"
          ],
          [
            "zig",
            "build",
            "test:spike",
            "-Dintegration-test-shards=8",
            "-j8"
          ],
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_artifact_reproducibility.TinyKgArtifactReproducibilityTest.test_two_isolated_vendor_builds_are_byte_identical_and_runnable",
            "scripts.tests.test_artifact_reproducibility.FormalKernelArtifactIdentityReproducibilityTest.test_two_isolated_complete_builds_share_identity_and_bind_time_receipts",
            "-v"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    },
    {
      "id": "eval.budget-checkpoint-durability.l2",
      "title": "Budget violations are durably checkpointed before evaluation abort",
      "target": {
        "metric": "budget_checkpoint_obligations_minus_observed",
        "setpoint": 0,
        "goal": "Every arm and order position receives the same fixed cap, the complete remaining schedule is feasible before network, measured usage is bound to that cap, and any violation is marked invalid and durably checkpointed before abort; promotion rechecks the same contract."
      },
      "sensor": {
        "adapter": "eval_budget_checkpoint",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.BudgetCheckpoint.evalBudgetSignal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "checkpoint_transition_requires_invalid_mark",
          "abort_transition_requires_committed_checkpoint",
          "canonical_budget_violation_trace_aborts",
          "abort_before_checkpoint_is_rejected",
          "eval_budget_admitted_implies_six_obligations",
          "eval_budget_missing_obligation_blocks",
          "eval_budget_wrong_cardinality_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore identical per-rollout caps, whole-schedule preflight before network, sealed usage validation, invalid marking before checkpoint publication, durable checkpoint publication before the raised abort, promotion-time revalidation, and their disk-backed counterexample tests. Source order or a pure marker test alone is insufficient.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "python_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 300,
        "commands": [
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.EvalBudgetCheckpointSensorTests",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_multi_arm_rejects_infeasible_remaining_schedule_before_rollout",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_multi_arm_checkpoints_runtime_budget_overrun_before_abort",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_promotion_rechecks_fixed_runtime_budget_and_usage",
            "-v"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    },
    {
      "id": "eval.treatment-activation.l2",
      "title": "TinyKG treatment activation is execution-grounded and reverified",
      "target": {
        "metric": "treatment_activation_obligations_minus_observed",
        "setpoint": 0,
        "goal": "Only the TinyKG arm activates one persistent create-claim-complete lifecycle; native events, transcript and frozen-store readback agree; failures are checkpointed before abort; resume and promotion recompute the attestation from raw artifacts before any further paid work or outcome claim."
      },
      "sensor": {
        "adapter": "treatment_activation",
        "schema_version": 1
      },
      "decision": {
        "engine": "lean",
        "kernel": "MetaCodesControl.TreatmentActivation.treatmentActivationSignal",
        "theorems": [
          "admitted_implies_closed_loop",
          "admitted_implies_zero_deviation",
          "admitted_implies_feedback_passed",
          "treatment_admitted_implies_store_verified",
          "store_verification_requires_completed",
          "canonical_treatment_trace_is_admitted",
          "claim_before_create_is_rejected",
          "complete_before_claim_is_rejected",
          "completion_without_store_readback_is_not_admitted",
          "baseline_admitted_implies_persistent_lifecycle_absent",
          "treatment_failure_checkpoint_requires_invalid_mark",
          "treatment_failure_abort_requires_committed_checkpoint",
          "treatment_failure_abort_before_checkpoint_is_rejected",
          "abort_without_invalid_mark_is_rejected",
          "treatment_activation_admitted_implies_seven_obligations",
          "treatment_activation_missing_obligation_blocks",
          "treatment_activation_wrong_cardinality_blocks",
          "orphan_cannot_be_compliant",
          "failed_feedback_blocks",
          "sensor_failure_blocks",
          "unobserved_actuator_blocks"
        ]
      },
      "actuator": {
        "kind": "release_gate",
        "on_violation": "block",
        "remediation": "Restore prompt/arm isolation, exact native-transcript hashes, the one-task create-claim-complete lifecycle, frozen TinyKG task-packet readback with verified_by evidence, mark-checkpoint-abort ordering, resume-before-network reattestation, promotion-time raw-artifact reattestation, and all real TinyKG/tamper/failure counterexamples. Source order, cached receipts, a pure marker test, or an uncommitted checkpoint attempt cannot satisfy the gate.",
        "observation": {
          "schema_version": 1,
          "build_file": "control-plane/build.zig",
          "build_step": "rule-check",
          "workflow_file": ".github/workflows/cross-platform.yml",
          "workflow_job": "rule-control",
          "workflow_workdir": "metacodes",
          "telemetry_path": "metacodes/zig-out/reports/rule-control.json"
        }
      },
      "feedback": {
        "kind": "python_l2_then_reobserve",
        "reobserve": true,
        "timeout_seconds": 300,
        "commands": [
          [
            "zig",
            "build",
            "vendor:tinykg"
          ],
          [
            "python",
            "-m",
            "unittest",
            "scripts.tests.test_rule_control.TreatmentActivationSensorTests",
            "scripts.eval.tests.test_treatment_activation.TreatmentActivationTest",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_multi_arm_checkpoints_treatment_failure_before_abort",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_multi_arm_does_not_abort_past_failed_treatment_checkpoint",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_multi_arm_resume_reverifies_treatment_before_network",
            "scripts.eval.tests.test_experiment.LongHorizonExperimentTest.test_promotion_reverifies_all_raw_treatment_artifacts",
            "-v"
          ]
        ]
      },
      "counterexample": {
        "fixture": "control-plane/counterexamples.json",
        "required": true
      }
    }
  ]
