    .kernel_budget = .{
        .package = "kernel",
        .max_lines = 4600,
        .max_dependencies = .{ "base", "ai" },
        .raise_reason = "migration 3.2a (GitHub #775): the pi-agent-core style minimal kernel (loop, hooks, tool interface, sequential and parallel executor) and its fake-provider tests, measured at 1001 lines on top of 3264, plus room for review fixes; 3.2b onward moves agent_loop onto it and takes the budget back down",
    },
