              "docs/config.md",
              "src/config.py",
              "tests/contract.txt"
            ],
            "checks": [
              {
                "kind": "contains",
                "path": "src/config.py",
                "value": "raw.get(\"requestHeader\", raw.get(\"traceHeader\"))"
              },
              {
                "kind": "contains",
                "path": "src/config.py",
                "value": "return {\"requestHeader\": config[\"requestHeader\"]}"
              },
              {
                "kind": "not_contains",
                "path": "src/config.py",
                "value": "return {\"traceHeader\": config[\"traceHeader\"]}"
              },
              {
                "kind": "contains",
                "path": "docs/config.md",
                "value": "`traceHeader` remains accepted as a legacy input alias."
              },
              {
                "kind": "equals",
                "path": "tests/contract.txt",
                "value": "canonical=requestHeader\nlegacy=traceHeader\n"
              }
            ]
          },
          "oracle_files": [
            {
              "path": "docs/config.md",
