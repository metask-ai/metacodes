      "id": "config-field-migration",
      "intent_template": "Migrate legacy configuration field `{old}` to canonical `{new}`. Update parser, serializer, docs, and round-trip contract while retaining input compatibility.",
      "procedure_evidence_id": "procedure:config-field-migration:v1",
      "cases": [
        {
          "id": "trace-header",
          "split": "online",
          "bindings": {
            "new": "requestHeader",
            "old": "traceHeader"
          },
          "workspace": {
            "files": [
              {
                "path": "docs/config.md",
                "content": "# Request tracing\n\n`traceHeader` is the canonical header configuration key.\n"
              },
              {
                "path": "src/config.py",
                "content": "def parse(raw):\n    return {\"traceHeader\": raw.get(\"traceHeader\")}\n\ndef serialize(config):\n    return {\"traceHeader\": config[\"traceHeader\"]}\n"
              },
              {
                "path": "tests/contract.txt",
                "content": "canonical=traceHeader\nlegacy=\n"
              }
            ]
          },
          "validator": {
            "kind": "workspace_assertions_v1",
            "allowed_changed_paths": [
              "docs/config.md",
              "src/config.py",
              "tests/contract.txt"
            ],
            "required_changed_paths": [
              "docs/config.md",
              "src/config.py",
              "tests/contract.txt"
            ],
            "checks": [
              {
                "kind": "contains",
                "path": "src/config.py",
                "value": "raw.get(\"requestHeader\", raw.get(\"traceHeader\"))"
              },
              {
                "kind": "contains",
                "path": "src/config.py",
                "value": "return {\"requestHeader\": config[\"requestHeader\"]}"
              },
              {
                "kind": "not_contains",
                "path": "src/config.py",
                "value": "return {\"traceHeader\": config[\"traceHeader\"]}"
              },
              {
                "kind": "contains",
                "path": "docs/config.md",
                "value": "`traceHeader` remains accepted as a legacy input alias."
              },
              {
                "kind": "equals",
                "path": "tests/contract.txt",
                "value": "canonical=requestHeader\nlegacy=traceHeader\n"
              }
            ]
          },
          "oracle_files": [
            {
              "path": "docs/config.md",
              "content": "# Request tracing\n\n`requestHeader` is the canonical header configuration key.\n`traceHeader` remains accepted as a legacy input alias.\n"
            },
            {
              "path": "src/config.py",
              "content": "def parse(raw):\n    return {\"requestHeader\": raw.get(\"requestHeader\", raw.get(\"traceHeader\"))}\n\ndef serialize(config):\n    return {\"requestHeader\": config[\"requestHeader\"]}\n"
            },
            {
              "path": "tests/contract.txt",
              "content": "canonical=requestHeader\nlegacy=traceHeader\n"
            }
          ]
        },
