          "tests/e2e/fixtures/agents/release-mcp.md",
          "tests/_harness/mock_mcp_server.zig"
        ]
      },
      "tools": {"profile": "metacodes-agentdef-release-v1", "required": ["Task", "ToolSearch", "allowed__echo", "Write"]},
      "constraints": {"timeout_seconds": 600, "permission_mode": "bypassPermissions"},
      "success": {
        "checks": [
          {"type": "contains", "path": "mcp-proof.txt", "text": "MCP_ALLOWLIST_SENTINEL", "description": "允许的 MCP server 完成真实 roundtrip"},
          {"type": "contains", "path": "mcp-proof.txt", "text": "allowed__echo", "description": "父 agent 固化实际允许工具名"},
          {"type": "debug_log_contains", "text": "tool.exec done(par) name=allowed__echo", "description": "子 agent 实际完成 allowed MCP roundtrip"},
          {"type": "debug_log_contains", "text": "tool.exec FAILED(par) name=ToolSearch err=NoToolMatch", "description": "ToolSearch 不会从全局 registry 泄露 blocked server 工具"},
          {"type": "debug_log_not_contains", "text": "tool.exec done(par) name=blocked__echo", "description": "blocked server 工具未完成动态执行"}
        ]
      },
      "trajectory_constraints": {
        "required_tools": ["Task", "Write"],
        "max_turns": 14,
        "max_tool_calls": 18,
        "max_model_tool_errors": 4,
        "max_harness_tool_errors": 0
      },
      "trajectory_rationale": {
        "required_tools": "父 Task 触发带 allowlist 的子 agent，父 Write 固化 MCP 返回；子层调用由 debug trace 精确判定。",
