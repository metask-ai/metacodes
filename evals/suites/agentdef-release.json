{
  "schema_version": 1,
  "suite_id": "metacodes-agentdef-release-v1",
  "description": "AgentDef background、memory、worktree isolation、provider effort 与 MCP allowlist 的真实模型发布门禁。",
  "tasks": [
    {
      "id": "40_agentdef_background",
      "scenario": "tests/e2e/scenarios/40_agentdef_background.txt",
      "layers": ["E", "T", "L", "O", "V"],
      "environment": {
        "kind": "isolated_workspace",
        "reset": "fresh_home_and_workdir",
        "fixtures": ["tests/e2e/fixtures/agents/release-background.md"]
      },
      "tools": {"profile": "metacodes-agentdef-release-v1", "required": ["Task", "TaskOutput", "Write"]},
      "constraints": {"timeout_seconds": 600, "permission_mode": "bypassPermissions"},
      "success": {
        "checks": [
          {"type": "contains", "path": "background-child.txt", "text": "BACKGROUND_CHILD_DONE", "description": "后台子 agent 完成真实文件副作用"},
          {"type": "contains", "path": "background-proof.txt", "text": "BACKGROUND_TERMINAL_COMPLETED", "description": "父 agent 在观察终态后写入证明"}
        ]
      },
      "trajectory_constraints": {
        "required_tools": ["Task", "TaskOutput", "Write"],
        "max_turns": 14,
        "max_tool_calls": 18,
        "max_model_tool_errors": 4,
        "max_harness_tool_errors": 0
      },
      "trajectory_rationale": {
        "required_tools": "AgentDef.background 必须让未显式传后台参数的 Task 返回 job id，并由父 agent 通过 TaskOutput 观察终态；Write 产生可执行副作用证据。",
        "max_turns": "一次后台任务及终态轮询应在有界父会话内完成。",
        "max_tool_calls": "允许短暂轮询但阻止无界 TaskOutput 风暴。",
        "max_model_tool_errors": "允许少量 job id 参数自纠，不接受反复错误。",
        "max_harness_tool_errors": "后台 registry、线程与终态合并不允许 harness 故障。"
      },
      "grader": {"kind": "deterministic_workspace", "version": "agentdef-release-v1"}
    },
    {
      "id": "41_agentdef_memory",
      "scenario": "tests/e2e/scenarios/41_agentdef_memory.txt",
      "layers": ["E", "T", "C", "L", "O", "V"],
      "environment": {
        "kind": "isolated_git_workspace",
        "reset": "fresh_home_workdir_and_git",
        "fixtures": ["tests/e2e/fixtures/agents/release-memory.md"]
      },
      "tools": {"profile": "metacodes-agentdef-release-v1", "required": ["Task", "Read", "Write"]},
      "constraints": {"timeout_seconds": 600, "permission_mode": "bypassPermissions"},
      "success": {
        "checks": [
          {"type": "contains", "path": ".metacodes/agent-memory/release-memory-0a9ec8a380a77ab2af4ed59785bb80ad/MEMORY.md", "text": "MEMORY_RELEASE_7F3A", "description": "秘密写入无碰撞的 project-scope memory 路径"},
          {"type": "contains", "path": "memory-proof.txt", "text": "MEMORY_RELEASE_7F3A", "description": "第二个新子 agent 能恢复秘密"}
        ]
      },
      "trajectory_constraints": {
        "required_tools": ["Task"],
        "max_turns": 18,
        "max_tool_calls": 24,
        "max_model_tool_errors": 5,
        "max_harness_tool_errors": 0
      },
      "trajectory_rationale": {
        "required_tools": "两次 Task 形成跨子 agent 恢复；第二个新子 agent 亲自 Read memory 并 Write proof，两个精确文件 outcome 同时验证写入与召回。",
        "max_turns": "保存、重新启动、恢复三阶段允许多轮但必须有界。",
        "max_tool_calls": "允许两个子 agent 各自读写记忆和父验收，不允许异常扇出。",
        "max_model_tool_errors": "路径和 must-read-first 可少量自纠，但不应持续失败。",
        "max_harness_tool_errors": "memory 目录、权限和 sandbox 接线不允许 harness 故障。"
      },
      "grader": {"kind": "deterministic_workspace", "version": "agentdef-release-v2"}
    },
    {
      "id": "42_agentdef_isolation",
      "scenario": "tests/e2e/scenarios/42_agentdef_isolation.txt",
      "layers": ["E", "T", "L", "O", "V", "G"],
      "environment": {
        "kind": "isolated_git_workspace",
        "reset": "fresh_home_workdir_and_git",
        "fixtures": ["tests/e2e/fixtures/agents/release-isolation.md"]
      },
      "tools": {"profile": "metacodes-agentdef-release-v1", "required": ["Task", "Write"]},
      "constraints": {"timeout_seconds": 600, "permission_mode": "bypassPermissions"},
      "success": {
        "checks": [
          {"type": "file_absent", "path": "isolation-child.txt", "description": "子 agent 修改没有泄漏到父 workspace"},
          {"type": "contains", "path": "isolation-proof.txt", "text": "worktree_path", "description": "Task 返回可审计 worktree 路径"},
          {"type": "contains", "path": "isolation-proof.txt", "text": "worktree_kept=true", "description": "有修改的 worktree 被保留"}
        ]
      },
      "trajectory_constraints": {
        "required_tools": ["Task", "Write"],
        "max_turns": 12,
        "max_tool_calls": 16,
        "max_model_tool_errors": 4,
        "max_harness_tool_errors": 0
      },
      "trajectory_rationale": {
        "required_tools": "Task 必须建立 AgentDef worktree，父 Write 仅记录结构化返回；根目录 absent 防止把普通子 agent 误判为隔离成功。",
        "max_turns": "单次隔离写入和验收无需长会话。",
        "max_tool_calls": "允许 git/worktree 内部动作与父验收，限制重复创建。",
        "max_model_tool_errors": "允许少量文件参数自纠但不接受 worktree 循环。",
        "max_harness_tool_errors": "worktree 创建、finalize 与结果序列化不允许 harness 故障。"
      },
      "grader": {"kind": "deterministic_workspace", "version": "agentdef-release-v1"}
    },
    {
      "id": "43_agentdef_effort",
