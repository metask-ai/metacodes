{
  "schema_version": 1,
  "suite_id": "metacodes-check-gate-v3",
  "description": "Host check gate evaluation cohort v3 (evals/experiments/check-gate-v3.md). Four hard self-authored single-module specifications over a frozen snapshot: README.md, a stub, 30-49 visible tests and `sh run_tests`, the command both arms pin with --host-check. The validator runs the pristine visible tests plus hidden tests over a copy of the workspace with its own tests replaced; partial credit is the fraction of those tests passing.",
  "tasks": [
    {
      "id": "d1_cg3_cron",
      "scenario": "tests/e2e/scenarios/d1_cg3_cron.txt",
      "layers": [
        "E",
        "T",
        "C",
        "L",
        "O",
        "V"
      ],
      "environment": {
        "kind": "isolated_workspace",
        "reset": "fresh_home_and_workdir",
        "repository_snapshot": {
          "revision": "7a860ef558c45a9342e937c9ad7e37a8a4b9476e",
          "prefix": "tests/e2e/fixtures/check_gate_v3/cron",
          "paths": [
            "README.md",
            "cronexpr.py",
            "run_tests",
            "tests/__init__.py",
            "tests/run.py",
            "tests/test_basics.py",
            "tests/test_calendar.py",
            "tests/test_errors.py",
            "tests/test_macros.py"
          ]
        }
      },
      "tools": {
        "profile": "metacodes-runtime-default-v1",
        "required": [
          "Read",
          "Write"
        ]
      },
      "constraints": {
        "timeout_seconds": 1800,
        "permission_mode": "bypassPermissions"
      },
      "success": {
        "checks": [
          {
            "type": "validator",
            "validator": "evals/validators/d1_check_gate_v3_cron.py",
            "timeout_seconds": 120,
            "description": "cron next-fire times: pristine visible tests plus hidden tests"
          }
        ]
      },
      "trajectory_constraints": {
        "max_turns": 100,
        "max_tool_calls": 200,
        "max_harness_tool_errors": 2
      },
      "trajectory_rationale": {
        "max_turns": "a hard one-module implementation with repeated test runs plus up to three host-check continuations; more than this is looping",
        "max_tool_calls": "writing one module and iterating on its tests needs far fewer; the turn cap is the kill, this is the violation flag",
        "max_harness_tool_errors": "a couple of tool-runtime errors are tolerated; more means the environment, not the agent"
      },
      "grader": {
        "kind": "deterministic_workspace",
        "version": "check-gate-v3"
      }
    },
