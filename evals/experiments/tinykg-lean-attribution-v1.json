    {
      "id": "memory_only",
      "tinykg": true,
      "lean": false
    },
    {
      "id": "lean_only",
      "tinykg": false,
      "lean": true
    },
    {
      "id": "combined",
      "tinykg": true,
      "lean": true
    }
  ],
  "stages": [
