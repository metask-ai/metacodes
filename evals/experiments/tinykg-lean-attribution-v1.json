  "statistics": {
    "binary_primary": "paired-exact-mcnemar-with-wilson-intervals",
    "continuous_primary": "paired-bootstrap-confidence-interval",
    "factorial_interaction": "paired-within-case-difference-in-differences-with-randomization-interval",
    "multiple_primary_contrasts": "holm-correction",
    "calibration_claim": "directional-and-operational-only",
    "confirmatory_claim": "requires-frozen-complete-schedule"
  },
  "promotion": {
    "requires": [
      "all rows valid and treatment actuation verified",
      "no trustworthy-success regression in either main-effect contrast",
      "zero unsafe Lean false interventions on the frozen safe set",
      "zero remote TinyKG writes and zero offline-memory write leakage",
      "combined arm no worse than control on trustworthy success",
      "at least one preregistered quality or recurrence metric improves",
      "cost, token, and wall-time deltas are reported rather than hidden",
      "cache contract passes",
      "candidate binary, ontology, rules, model, tools, and prompts are frozen before WorkBuddy"
    ],
    "forbids": [
      "outcome-based early stopping inside a confirmatory schedule",
      "automatic retry after request_authorized",
      "using WorkBuddy sealed outcomes for tuning",
      "claiming general TinyKG or Lean superiority from one correction family"
    ]
  },
  "isolation": {
    "tinykg": "fresh run-local direct binary store",
    "remote_skill_harness_forbidden": true,
    "raw_tasks_traces_journals_local_only": true,
    "remote_tinykg_content": "roadmap and aggregate conclusions only"
  },
  "budget": {
