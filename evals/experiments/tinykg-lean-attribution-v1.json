      "on": "fresh isolated local TinyKG seeded only from the arm-authorized public history"
    },
    "lean": {
      "off": "project rule bundle staged but inactive",
      "on": "hash-pinned project rule bundle enforced by the compiled project kernel"
    }
  },
  "factorial_cells": [
